# Runtime only: use the approved existing PostgreSQL project.
DATABASE_PROVIDER=postgresql
DATABASE_URL=
SUPABASE_PROJECT_REF=
DATABASE_CUTOVER_APPROVED=false
DATABASE_READ_ONLY=false
PORT=4100
# Session Pooler 5432; database postgres; schema creator_hq; runtime user only.
# Prisma 6: sslmode=require, sslaccept=strict, sslcert=<encoded private CA path>.
# Encode password and certificate-path components once, never the complete URL.
# Bounds: connect_timeout=10, pool_timeout=10, socket_timeout=20, connection_limit=5.
# Optional total connect/pool/query health deadline (1000..60000 ms).
# Default with the bounds above: 40000 ms.
# HEALTH_TIMEOUT_MS=40000
BACKUP_DIR=../../.local/backups
BACKUP_RETENTION_DAYS=30
# Historical receipts/SQLite copies are preserved; runtime does not require them.
# Never include DIRECT_URL here. Admin credentials belong only in .env.migration.
