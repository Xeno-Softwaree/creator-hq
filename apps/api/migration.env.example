# Copy to .env.migration; this file is used only by explicit migration/backup commands.
# Never put database credentials in a frontend or NEXT_PUBLIC_* variable.
DATABASE_URL=
DIRECT_URL=
SUPABASE_PROJECT_REF=
# Session Pooler IPv4: use the copied dashboard host and port 5432 for BOTH URLs.
# DATABASE_URL username: creator_hq_runtime.PROJECT_REF, with its own role password.
# DIRECT_URL username: postgres.PROJECT_REF, with the administrative database password.
# No pgbouncer=true for the selected Session Pooler method. See docs/supabase-access.md.
# Both URLs require schema=creator_hq, sslmode=require, sslaccept=strict,
# connect_timeout=10, pool_timeout=10, socket_timeout=20, connection_limit=5.
# For Prisma 6.19.3, add sslcert pointing to the privately stored dashboard root CA.
# URL-encode the absolute forward-slash certificate path once; keep sslaccept=strict.
# Native libpq uses sslrootcert/PGSSLROOTCERT instead; these names are not interchangeable.
# Runtime role: creator_hq_runtime (append the project reference only for pooler usernames).
# DIRECT_URL must use port 5432, never the transaction pooler.
SQLITE_SOURCE_PATH=prisma/creator.db
SQLITE_BACKUP_MANIFEST=
MIGRATION_REPORT_DIR=../../.local/phase12
MIGRATION_SCHEMA_APPROVED=false
MIGRATION_DATA_APPROVED=false
MIGRATION_PROBE_APPROVED=false
MIGRATION_SOURCE_FROZEN=false
# Local directory; do not commit an absolute personal path.
BACKUP_DIR=../../.local/backups
BACKUP_RETENTION_DAYS=30
# Optional absolute paths to installed PostgreSQL client executables:
# PG_DUMP_BIN=
# PG_RESTORE_BIN=
