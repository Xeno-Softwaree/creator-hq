# API: configure apps/api/.env privately; this root file is not loaded.
DATABASE_PROVIDER=postgresql
DATABASE_URL=
SUPABASE_PROJECT_REF=
DATABASE_CUTOVER_APPROVED=false
DATABASE_READ_ONLY=false
PORT=4100
# Package 4 local integration: separate human-owner authentication; never use a DB password.
# Leave blank until explicitly provisioned. Real agent execution remains code-locked.
CREATOR_OWNER_PASSWORD_HASH=
# Optional absolute path to a private .local Codex runtime JSON file; not an execution switch.
CREATOR_CODEX_RUNTIME_FILE=
# See docs/postgresql-installation.md. Never include admin/public database credentials.

# Web: place these values in apps/web/.env.local. Rebuild after changing public variables.
# personal: Turkish default. public: browser detection with English fallback.
# A previously saved valid language preference always wins.
NEXT_PUBLIC_DEPLOYMENT_MODE=personal
NEXT_PUBLIC_API_URL=http://127.0.0.1:4100

# Optional display-only locations. These do not grant filesystem access.
# NEXT_PUBLIC_* values are visible in the browser. Never put secrets or personal paths here in a shared build.
NEXT_PUBLIC_STORAGE_APP_PATH=./
NEXT_PUBLIC_STORAGE_VAULT_PATH=./private/vaults
NEXT_PUBLIC_STORAGE_MEDIA_PATH=./private/media
NEXT_PUBLIC_STORAGE_BACKUP_PATH=./private/backups

# Privileged migration/backup commands use .env.migration, separate from runtime.
# See apps/api/migration.env.example. Never copy database URLs into web variables.
